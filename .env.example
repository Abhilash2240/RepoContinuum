# RepoContinuum Environment Configuration
# Copy this file to .env and configure local values

# Logging
REPOCONTINUUM_LOG_LEVEL=INFO

# Indexer Configuration
REPOCONTINUUM_MAX_FILE_SIZE_BYTES=1048576
REPOCONTINUUM_INCLUDE_UNTRACKED=true

# Database (For Future Milestones)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repocontinuum

# Redis (For Future Milestones)
# REDIS_URL=redis://localhost:6379/0
