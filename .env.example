# RepoContinuum Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# Never commit .env with active production secrets.

# Canonical Database Configuration
REPOCONTINUUM_DATABASE_URL=sqlite:///repocontinuum.db

# LLM Provider Configuration ("fake" for local offline testing, "gemini" for live Google GenAI)
REPOCONTINUUM_LLM_PROVIDER=fake

# Google Gemini API Configuration (Required when REPOCONTINUUM_LLM_PROVIDER=gemini)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# LLM Execution Parameters
REPOCONTINUUM_LLM_TEMPERATURE=0.2
REPOCONTINUUM_LLM_TIMEOUT_SECONDS=60

# Bounded Agent Safeguards and Budgets
REPOCONTINUUM_MAX_REPAIR_ATTEMPTS=2
REPOCONTINUUM_MAX_TOOL_CALLS=10
REPOCONTINUUM_MAX_CONTEXT_CHARS=16000
